# Copiá este archivo a .env y ajustá los valores. No subas .env al repositorio.
DATABASE_URL="postgresql://munchkin:munchkin@localhost:5432/patea?schema=public"
PORT=3000
NODE_ENV=development
# Días de inactividad antes de que una sala venza (por defecto 7).
ROOM_TTL_DAYS=7
# URL pública opcional para armar enlaces/QR (ej. https://tu-app.onrender.com). Si falta, se usa el origen del navegador.
PUBLIC_URL=
# Keep-alive para Render Free: en producción el servidor se llama a sí mismo cada 10 min
# mientras haya actividad. Usa PUBLIC_URL o RENDER_EXTERNAL_URL (Render la define sola).
# KEEPALIVE_URL=https://tu-app.onrender.com
# Horas sin actividad tras las que se deja dormir al servidor (por defecto 2).
# MAX_OPEN_ROOMS=300        # tope de salas abiertas a la vez
# MAX_ROOMS_PER_DAY=150     # tope de salas nuevas en 24 h entre todos
# KEEPALIVE_IDLE_HOURS=0   # 0 o vacío = siempre despierto; un número = horas sin actividad antes de dejarlo dormir
# Notificaciones push (opcional): si faltan, el servidor genera las claves VAPID una vez y las guarda en la base.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu-mail@ejemplo.com
