# Copiá este archivo a .env y ajustá los valores. No subas .env al repositorio.
DATABASE_URL="postgresql://munchkin:munchkin@localhost:5432/patea?schema=public"
PORT=3000
NODE_ENV=development
# Días de inactividad antes de que una sala venza (por defecto 7).
ROOM_TTL_DAYS=7
# URL pública opcional para armar enlaces/QR (ej. https://tu-app.onrender.com). Si falta, se usa el origen del navegador.
PUBLIC_URL=
